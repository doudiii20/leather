PORT=3000

# Connexion Oracle via ODBC Windows (meme logique que l app Qt — pas besoin d Instant Client)
# Option A : DSN + utilisateur (comme dans ton projet)
ODBC_DSN=projet_cuir
ORACLE_USER=system
ORACLE_PASSWORD=your_password

# Option B : chaine ODBC complete (remplace Option A si tu preferes)
# ODBC_CONNECTION_STRING=DSN=projet_cuir;UID=system;PWD=your_password

# API behavior
LOW_STOCK_THRESHOLD=10
CRITICAL_STOCK_THRESHOLD=5
STOCK_DAILY_CONSUMPTION=2
